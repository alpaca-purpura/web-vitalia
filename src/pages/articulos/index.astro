---
import BaseHead from '../../components/BaseHead.astro';
import { getCollection } from 'astro:content';

const articles = await getCollection('articles');
---

<!DOCTYPE html>
<html lang="es">
	<head>
		<BaseHead title="Artículos | Vitalia SaaS" description="Lee nuestros últimos artículos sobre biohacking y SaaS." />
		<style>
			body { font-family: 'Inter', sans-serif; background-color: #0f172a; color: #f8fafc; margin: 0; }
			header { padding: 2rem; border-bottom: 1px solid #1e293b; text-align: center; }
			main { max-width: 800px; margin: 0 auto; padding: 4rem 2rem; }
			.nav-links a { color: #cbd5e1; text-decoration: none; margin: 0 1rem; }
			ul { list-style: none; padding: 0; }
			li { margin-bottom: 2rem; padding-bottom: 2rem; border-bottom: 1px solid #1e293b; }
			li a { color: #38bdf8; text-decoration: none; font-size: 1.5rem; font-weight: bold; }
			li p { color: #94a3b8; }
		</style>
	</head>
	<body>
		<header>
			<nav class="nav-links">
				<a href="/">Home</a>
				<a href="/articulos">Artículos</a>
				<a href="/estudios">Estudios</a>
			</nav>
		</header>
		<main>
			<h1>Blog de Vitalia</h1>
			<ul>
				{
					articles.map((post) => (
						<li>
							<a href={`/articulos/${post.slug}/`}>{post.data.title}</a>
							<p>{post.data.description}</p>
						</li>
					))
				}
			</ul>
		</main>
	</body>
</html>
