---
import BaseHead from '../components/BaseHead.astro';
import { SEO } from 'astro-seo';

const SITE_TITLE = "Vitalia SaaS | Tu Agente Comercial IA";
const SITE_DESCRIPTION = "Conoce a Vitalia, tu Recepcionista y Setter 24/7. El futuro de las clínicas en Tacna.";

// JSON-LD schema for AEO/RAG (SoftwareApplication)
const schema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Vitalia",
  "applicationCategory": "BusinessApplication",
  "description": "Vitalia es una plataforma de software como servicio (SaaS) y agente conversacional de Inteligencia Artificial diseñado para la atracción, conversión y fidelización de clientes en clínicas del sector salud y estética en Tacna, resolviendo la logística del turismo médico transfronterizo.",
  "offers": {
    "@type": "Offer",
    "availability": "https://schema.org/PreOrder"
  }
};
---

<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
		<SEO
			title={SITE_TITLE}
			description={SITE_DESCRIPTION}
			openGraph={{
				basic: {
					title: SITE_TITLE,
					type: "website",
					image: "https://vitalialatam.com/og-image.jpg",
				}
			}}
		/>
		<script type="application/ld+json" set:html={JSON.stringify(schema)} />
	</head>
	<body class="bg-white text-slate-900 font-sans antialiased overflow-x-hidden selection:bg-vitalia-cyan selection:text-white">
		
		<!-- AEO Identity Block -->
		<div class="sr-only" id="identity-block">
			<h2>¿Qué es Vitalia?</h2>
			<p>Vitalia es una plataforma de software como servicio (SaaS) y agente conversacional de Inteligencia Artificial diseñado para la atracción, conversión y fidelización de clientes en clínicas del sector salud y estética en Tacna.</p>
		</div>

		<!-- Nav -->
		<header class="fixed top-6 w-full z-50 px-6 flex justify-center pointer-events-none">
			<div class="pointer-events-auto bg-white/90 backdrop-blur-md border border-slate-200 shadow-sm rounded-full px-6 py-3 flex items-center justify-between w-full max-w-5xl">
				<div class="flex items-center gap-2">
					<span class="text-xl font-extrabold tracking-tighter text-vitalia-navy">VITALIA</span>
				</div>
				<nav class="hidden md:flex gap-8">
					<a href="#" class="text-sm font-semibold text-slate-600 hover:text-vitalia-cyan transition-colors">Habilidades</a>
					<a href="#" class="text-sm font-semibold text-slate-600 hover:text-vitalia-cyan transition-colors">Beneficios</a>
				</nav>
				<a href="#waitlist" class="px-5 py-2.5 text-sm font-bold text-white bg-vitalia-cyan hover:bg-vitalia-navy transition-all rounded-full flex items-center gap-2 group">
					Pre-inscribirme
					<svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
				</a>
			</div>
		</header>

		<main class="pt-32 pb-20 px-6 max-w-6xl mx-auto space-y-6">
			
			<!-- Top Section: Image & Intro -->
			<section class="grid md:grid-cols-2 gap-6">
				<!-- Left: Avatar Image (Bento Box) -->
				<div class="bg-vitalia-cyan/10 rounded-[2.5rem] overflow-hidden relative aspect-square md:aspect-auto md:h-full">
					<!-- Badges -->
					<div class="absolute top-6 left-6 z-10 flex flex-col gap-2">
						<span class="px-4 py-1.5 bg-white/30 backdrop-blur-md text-white text-xs font-bold rounded-full border border-white/40 flex items-center gap-2">
							<span class="w-2 h-2 rounded-full bg-white animate-pulse"></span>
							Setter de Ventas
						</span>
						<span class="px-4 py-1.5 bg-vitalia-navy/40 backdrop-blur-md text-white text-xs font-bold rounded-full border border-white/20 w-fit">
							Concierge Clínico
						</span>
					</div>
					<img src="/images/hero-ai-light.png" alt="Vitalia AI" class="w-full h-full object-cover" />
				</div>

				<!-- Right: Intro text (Bento Box) -->
				<div class="bg-[#f8f9fa] rounded-[2.5rem] p-10 md:p-14 flex flex-col justify-center">
					<h1 class="text-4xl md:text-5xl lg:text-6xl font-medium tracking-tight leading-[1.1] mb-6 text-slate-900">
						Hola, soy Vitalia, tu <br/>
						<span class="text-vitalia-cyan font-bold">Agente Comercial 24/7</span>
					</h1>
					<p class="text-lg text-slate-600 mb-10 leading-relaxed max-w-md font-light">
						No soy un simple chatbot. Soy la encargada de convertir a tus leads en pacientes reales. Cotizo en Pesos Chilenos (CLP), escalo casos complejos, y agendo las citas de tu clínica en Tacna sin fricciones.
					</p>
					<div>
						<a href="#waitlist" class="inline-flex items-center gap-3 px-8 py-4 text-lg font-bold text-white bg-vitalia-cyan hover:bg-vitalia-navy transition-all rounded-full shadow-[0_8px_20px_rgba(1,178,248,0.3)] group">
							Contrátame ahora
							<div class="w-8 h-8 rounded-full bg-white text-vitalia-cyan flex items-center justify-center group-hover:translate-x-1 transition-transform">
								<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
							</div>
						</a>
					</div>
				</div>
			</section>

			<!-- Middle Section: Stats -->
			<section class="grid md:grid-cols-3 gap-6">
				<div class="bg-[#f8f9fa] rounded-[2.5rem] p-10 text-center flex flex-col items-center justify-center">
					<div class="flex items-center gap-3 mb-4">
						<span class="text-5xl font-bold text-vitalia-cyan">0%</span>
						<svg class="w-10 h-10 text-vitalia-cyan" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"></path></svg>
					</div>
					<p class="text-lg font-semibold text-slate-800">Pérdidas por No-shows</p>
					<p class="text-sm text-slate-500 mt-2">Cobra fianzas y anticipos en piloto automático.</p>
				</div>
				<div class="bg-[#f8f9fa] rounded-[2.5rem] p-10 text-center flex flex-col items-center justify-center">
					<div class="flex items-center gap-3 mb-4">
						<span class="text-5xl font-bold text-vitalia-cyan">< 90s</span>
						<svg class="w-10 h-10 text-vitalia-cyan" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
					</div>
					<p class="text-lg font-semibold text-slate-800">Para responder a tus leads</p>
					<p class="text-sm text-slate-500 mt-2">Atención inmediata antes de que crucen la frontera.</p>
				</div>
				<div class="bg-[#f8f9fa] rounded-[2.5rem] p-10 text-center flex flex-col items-center justify-center">
					<div class="flex items-center gap-3 mb-4">
						<span class="text-5xl font-bold text-vitalia-cyan">+3h</span>
						<svg class="w-10 h-10 text-vitalia-cyan" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14 10h4.764a2 2 0 011.789 2.894l-3.5 7A2 2 0 0115.263 21h-4.017c-.163 0-.326-.02-.485-.06L7 20m7-10V5a2 2 0 00-2-2h-.095c-.5 0-.905.405-.905.905 0 .714-.211 1.412-.608 2.006L7 11v9m7-10h-2M7 20H5a2 2 0 01-2-2v-6a2 2 0 012-2h2.514"></path></svg>
					</div>
					<p class="text-lg font-semibold text-slate-800">Libres al día para tu equipo</p>
					<p class="text-sm text-slate-500 mt-2">Menos tareas de bot, más atención humana cálida.</p>
				</div>
			</section>

			<!-- Bottom Section: Chat & Integrations -->
			<section class="grid md:grid-cols-2 gap-6">
				<!-- Chat Mockup -->
				<div class="bg-[#f8f9fa] rounded-[2.5rem] p-10 md:p-12 overflow-hidden relative">
					<h2 class="text-3xl md:text-4xl font-medium mb-4 text-slate-900">
						Así es como <span class="text-vitalia-cyan font-bold">Vitalia</span> habla con tus pacientes
					</h2>
					<p class="text-slate-600 mb-8 max-w-sm">
						Mira cómo entiende el contexto, responde dudas de frontera, cotiza en Pesos Chilenos y agenda en tiempo real, creando experiencias empáticas.
					</p>
					
					<!-- Simulated WhatsApp Chat UI -->
					<div class="relative w-full max-w-sm mx-auto bg-[#efeae2] rounded-3xl p-4 shadow-xl border border-slate-200 h-[400px] overflow-hidden flex flex-col">
						<!-- Chat Header -->
						<div class="bg-white px-4 py-3 rounded-2xl flex items-center gap-3 mb-4 shadow-sm">
							<div class="w-10 h-10 rounded-full bg-vitalia-cyan overflow-hidden">
								<img src="/images/hero-ai-light.png" alt="Avatar" class="w-full h-full object-cover">
							</div>
							<div>
								<p class="font-semibold text-slate-800 text-sm">Vitalia Clínica</p>
								<p class="text-xs text-green-500">En línea</p>
							</div>
						</div>
						<!-- Messages -->
						<div class="flex-1 space-y-4 relative z-10">
							<div class="bg-white p-3 rounded-2xl rounded-tl-sm w-[85%] shadow-sm text-sm text-slate-700">
								Hola! Vengo desde Arica este fin de semana, necesito cotizar un implante dental. ¿Aceptan pesos chilenos?
							</div>
							<div class="bg-[#d9fdd3] p-3 rounded-2xl rounded-tr-sm w-[85%] shadow-sm text-sm text-slate-700 self-end ml-auto">
								¡Hola! Claro que sí. El implante base está en $500 USD, que al cambio de hoy en Tacna son aprox. $485,000 CLP. ¡Te ahorras casi un 40% frente a clínicas en Chile! ¿Te gustaría que revise los horarios disponibles para este sábado?
							</div>
							<div class="bg-white p-3 rounded-2xl rounded-tl-sm w-[75%] shadow-sm text-sm text-slate-700">
								Genial, me sirve el sábado en la mañana. ¿A qué hora hay menos tráfico en la frontera?
							</div>
						</div>
						<!-- Input -->
						<div class="mt-4 bg-white rounded-full px-4 py-3 text-slate-400 text-sm shadow-sm flex items-center justify-between relative z-10">
							Escribe un mensaje...
							<svg class="w-5 h-5 text-vitalia-cyan" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path></svg>
						</div>

						<!-- Avatar Overlay (Like Darwin Alba) -->
						<div class="absolute -bottom-10 -right-10 w-64 h-64 opacity-90 pointer-events-none">
							<img src="/images/hero-ai-light.png" alt="Vitalia Background" class="w-full h-full object-cover rounded-full mix-blend-multiply" />
						</div>
					</div>
				</div>

				<!-- Integrations & Waitlist -->
				<div class="bg-[#f8f9fa] rounded-[2.5rem] p-10 md:p-12 flex flex-col justify-between" id="waitlist">
					<div>
						<h2 class="text-3xl md:text-4xl font-medium mb-4 text-slate-900">
							<span class="text-vitalia-cyan font-bold">Integración</span> nativa con tus canales de venta
						</h2>
						<p class="text-slate-600 mb-10">
							Vitalia vive donde están tus pacientes. Se conecta a WhatsApp, Instagram, y sincroniza automáticamente con tu Google Calendar o software médico.
						</p>
					</div>

					<!-- App Icons Grid (Simulated) -->
					<div class="bg-white/50 backdrop-blur-sm border border-slate-200 rounded-3xl p-6 flex flex-wrap gap-4 justify-center items-center mb-10 shadow-sm">
						<div class="w-14 h-14 bg-[#25D366] rounded-2xl shadow-md flex items-center justify-center text-white text-3xl">💬</div>
						<div class="w-14 h-14 bg-gradient-to-tr from-[#f09433] to-[#bc1888] rounded-2xl shadow-md flex items-center justify-center text-white text-3xl">📷</div>
						<div class="w-14 h-14 bg-[#0084FF] rounded-2xl shadow-md flex items-center justify-center text-white text-3xl">⚡</div>
						<div class="w-14 h-14 bg-white rounded-2xl shadow-md flex items-center justify-center border border-slate-100 p-2">
							<svg viewBox="0 0 48 48" class="w-full h-full"><path fill="#4285F4" d="M34 6H14c-4.4 0-8 3.6-8 8v20c0 4.4 3.6 8 8 8h20c4.4 0 8-3.6 8-8V14c0-4.4-3.6-8-8-8zm-4 24H18v-2h12v2zm0-4H18v-2h12v2zm0-4H18v-2h12v2z"/></svg>
						</div>
						<div class="w-14 h-14 bg-vitalia-cyan rounded-2xl shadow-md flex items-center justify-center text-white font-bold text-2xl">+</div>
					</div>

					<!-- Waitlist Form CTA -->
					<div class="bg-white p-6 rounded-3xl border border-slate-200 shadow-lg">
						<h3 class="text-xl font-bold mb-4 text-vitalia-navy">Asegura tu cupo en la Beta Privada</h3>
						<form class="flex flex-col gap-3">
							<input type="email" placeholder="Correo electrónico de tu clínica" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 text-slate-800 focus:outline-none focus:border-vitalia-cyan focus:ring-1 focus:ring-vitalia-cyan" required>
							<button type="submit" class="w-full flex items-center justify-center gap-2 py-3 text-center font-bold text-white bg-vitalia-cyan hover:bg-vitalia-navy transition-all rounded-xl">
								Unirme a la Waitlist
								<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
							</button>
						</form>
					</div>
				</div>
			</section>

		</main>

		<footer class="py-10 text-center text-slate-400 text-sm">
			<p>© {new Date().getFullYear()} Vitalia SaaS. Hecho con ❤️ en Tacna, Perú.</p>
		</footer>
	</body>
</html>
