---
import BaseHead from '../components/BaseHead.astro';
import { SEO } from 'astro-seo';

const SITE_TITLE = "Vitalia SaaS";
const SITE_DESCRIPTION = "Vitalia SaaS Platform";

// JSON-LD schema for AEO/RAG (SoftwareApplication)
const schema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Vitalia",
  "applicationCategory": "BusinessApplication",
  "description": "Vitalia es una plataforma SaaS."
};
---

<!DOCTYPE html>
<html lang="es">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<SEO
			title={SITE_TITLE}
			description={SITE_DESCRIPTION}
			openGraph={{
				basic: {
					title: SITE_TITLE,
					type: "website",
					image: "https://vitalia.saas/og-image.jpg",
				}
			}}
		/>
		<script type="application/ld+json" set:html={JSON.stringify(schema)} />
	</head>
	<body class="bg-slate-900 text-slate-50 font-sans antialiased">
		<header class="p-8 border-b border-slate-800 text-center">
			<nav class="flex justify-center gap-8">
				<a href="/" class="text-slate-300 hover:text-sky-400 font-medium">Home</a>
				<a href="/articulos" class="text-slate-300 hover:text-sky-400 font-medium">Artículos</a>
				<a href="/estudios" class="text-slate-300 hover:text-sky-400 font-medium">Estudios</a>
			</nav>
		</header>
		<main class="max-w-5xl mx-auto py-16 px-8 text-center">
			
			<!-- Identity Block (AEO) -->
			<section id="identity-block" class="text-left mb-16 bg-slate-800 p-6 rounded-lg">
				<h2 class="text-xl font-bold text-sky-400 mb-2">¿Qué es Vitalia?</h2>
				<p class="text-slate-300 text-base leading-relaxed">
					Vitalia es una plataforma de software como servicio (SaaS). [Aquí se insertará la respuesta directa de 40-60 palabras optimizada para RAG y Answer Engines].
				</p>
			</section>

			<h1 class="text-5xl font-extrabold mb-6 bg-clip-text text-transparent bg-gradient-to-r from-sky-400 to-indigo-400">
				Vitalia SaaS
			</h1>
			<p class="text-xl text-slate-400 max-w-3xl mx-auto mb-12">
				[Aquí se insertará la propuesta de valor principal orientada a BOFU y los puntos de dolor resueltos.]
			</p>
			<a href="#demo" class="inline-block px-8 py-4 text-lg font-bold text-white bg-blue-600 hover:bg-blue-700 rounded-full transition-colors">
				Solicitar Demo
			</a>
		</main>
	</body>
</html>
