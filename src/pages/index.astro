---
import BaseHead from '../components/BaseHead.astro';
import { SEO } from 'astro-seo';

const SITE_TITLE = "Vitalia | Tu Agente Comercial IA para Clínicas";
const SITE_DESCRIPTION = "Conoce a Vitalia, tu Recepcionista y Setter 24/7. El futuro de las clínicas en Tacna.";

const schema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Vitalia",
  "applicationCategory": "BusinessApplication",
  "description": "Vitalia es una plataforma de software como servicio (SaaS) y agente conversacional de Inteligencia Artificial diseñado para la atracción, conversión y fidelización de clientes en clínicas del sector salud y estética en Tacna.",
  "offers": {
    "@type": "Offer",
    "availability": "https://schema.org/PreOrder"
  }
};
---

<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
		<SEO
			title={SITE_TITLE}
			description={SITE_DESCRIPTION}
			openGraph={{
				basic: {
					title: SITE_TITLE,
					type: "website",
					image: "https://vitalialatam.com/og-image.jpg",
				}
			}}
		/>
		<script type="application/ld+json" set:html={JSON.stringify(schema)} />
	</head>
	<body class="bg-white text-slate-900 font-sans antialiased overflow-x-hidden selection:bg-vitalia-cyan selection:text-white">

		<!-- AEO Identity Block -->
		<div class="sr-only">
			<h2>¿Qué es Vitalia?</h2>
			<p>Vitalia es una plataforma SaaS y agente conversacional de IA para la atracción, conversión y fidelización de clientes en clínicas de salud y estética en Tacna.</p>
		</div>

		<!-- Floating Nav -->
		<header class="fixed top-4 md:top-6 w-full z-50 px-4 md:px-6 flex justify-center pointer-events-none">
			<div class="pointer-events-auto bg-white/90 backdrop-blur-md border border-slate-200/80 shadow-lg shadow-slate-200/40 rounded-full px-5 md:px-7 py-3 flex items-center justify-between w-full max-w-5xl">
				<div class="flex items-center gap-2">
					<img src="/vitalia-logo.png" alt="Vitalia" class="h-7 w-auto" />
				</div>
				<nav class="hidden md:flex gap-8">
					<a href="#habilidades" class="text-sm font-medium text-slate-500 hover:text-vitalia-cyan transition-colors">Características</a>
					<a href="#como-trabajo" class="text-sm font-medium text-slate-500 hover:text-vitalia-cyan transition-colors">Ecosistema</a>
					<a href="#integraciones" class="text-sm font-medium text-slate-500 hover:text-vitalia-cyan transition-colors">Integraciones</a>
				</nav>
				<a href="#waitlist" class="px-4 md:px-5 py-2 text-sm font-bold text-white bg-vitalia-cyan hover:bg-vitalia-navy transition-all rounded-full flex items-center gap-2 group">
					Probar Vitalia
					<svg class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"></path></svg>
				</a>
			</div>
		</header>

		<main>

			<!-- ==================== HERO SECTION ==================== -->
			<section class="relative pt-28 md:pt-36 pb-16 md:pb-24 px-6 max-w-6xl mx-auto">
				<!-- Decorative squares -->
				<div class="absolute top-20 left-4 md:left-12 w-16 h-16 md:w-20 md:h-20 bg-vitalia-cyan/10 rounded-2xl rotate-12 blur-sm"></div>
				<div class="absolute top-40 right-8 md:right-20 w-12 h-12 bg-vitalia-purple/10 rounded-xl -rotate-6 blur-sm"></div>

				<!-- Row 1: 2 columns — Avatar + Content -->
				<div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6">
					<!-- Left: AI Avatar -->
					<div class="bg-gradient-to-br from-vitalia-cyan/10 via-vitalia-cyan/5 to-vitalia-purple/5 rounded-[2rem] md:rounded-[2.5rem] overflow-hidden relative aspect-[4/3] md:aspect-auto md:h-full min-h-[320px] md:min-h-[420px] border border-slate-100/80">
						<!-- Floating badges -->
						<div class="absolute top-4 left-4 md:top-6 md:left-6 z-10 flex flex-col gap-2">
							<span class="px-3 py-1.5 bg-vitalia-cyan/90 backdrop-blur-sm text-white text-[10px] md:text-xs font-bold rounded-full flex items-center gap-2 shadow-lg shadow-vitalia-cyan/20">
								<span class="w-2 h-2 rounded-full bg-white animate-pulse"></span>
								Atrae, Atiende, Retiene
							</span>
							<span class="px-3 py-1.5 bg-vitalia-navy/90 backdrop-blur-sm text-white text-[10px] md:text-xs font-bold rounded-full shadow-lg">
								SDR Conversacional
							</span>
						</div>
						<!-- Corner squares -->
						<div class="absolute bottom-4 right-4 md:bottom-6 md:right-6 flex gap-1.5 md:gap-2">
							<div class="w-5 h-5 md:w-6 md:h-6 bg-vitalia-cyan/30 rounded-md"></div>
							<div class="w-5 h-5 md:w-6 md:h-6 bg-vitalia-purple/30 rounded-md"></div>
							<div class="w-5 h-5 md:w-6 md:h-6 bg-vitalia-yellow/40 rounded-md"></div>
						</div>
						<img src="/images/hero-ai-light.png" alt="Vitalia AI" class="w-full h-full object-cover" />
					</div>

					<!-- Right: Headline + Description + CTA -->
					<div class="bg-slate-50 rounded-[2rem] md:rounded-[2.5rem] p-8 md:p-12 flex flex-col justify-center border border-slate-100/80">
						<div class="inline-flex items-center gap-2 px-3 py-1.5 bg-vitalia-cyan/10 rounded-full w-fit mb-5">
							<span class="w-2 h-2 rounded-full bg-vitalia-cyan animate-pulse"></span>
							<span class="text-[10px] md:text-xs font-semibold text-vitalia-navy">Growth Engine</span>
						</div>
						<h1 class="text-3xl md:text-4xl lg:text-5xl font-medium tracking-tight leading-[1.1] mb-5 text-slate-900">
							Más que un chat. <br/>
							Soy tu <span class="text-vitalia-cyan font-bold">Motor de Crecimiento</span>
						</h1>
						<p class="text-base md:text-lg text-slate-500 mb-8 leading-relaxed font-light">
							Olvídate de la recepcionista saturada. Con Vitalia, tu clínica atrae pacientes en automático, los convierte con cotizaciones exactas y les da un seguimiento implacable para que nunca fallen a su cita.
						</p>
						<a href="#waitlist" class="inline-flex items-center gap-3 px-7 py-3.5 text-base font-bold text-white bg-vitalia-cyan hover:bg-vitalia-navy transition-all rounded-full shadow-lg shadow-vitalia-cyan/25 group w-fit">
							Escalar mi clínica
							<svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
						</a>
					</div>
				</div>

				<!-- Row 2: 3 columns — Stats -->
				<div class="mt-4 md:mt-6 grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-6">
					<div class="bg-slate-50 rounded-[2rem] md:rounded-[2.5rem] p-6 md:p-10 text-center flex flex-col items-center justify-center border border-slate-100/80">
						<span class="text-4xl md:text-5xl font-bold text-vitalia-cyan mb-2">5x</span>
						<p class="text-sm md:text-base text-slate-500 font-medium">Más leads calificados</p>
						<p class="text-xs text-slate-400 mt-2 max-w-[180px]">Interacciones que detectan intención real de compra automáticamente.</p>
					</div>
					<div class="bg-slate-50 rounded-[2rem] md:rounded-[2.5rem] p-6 md:p-10 text-center flex flex-col items-center justify-center border border-slate-100/80">
						<span class="text-4xl md:text-5xl font-bold text-vitalia-purple mb-2">+50%</span>
						<p class="text-sm md:text-base text-slate-500 font-medium">Conversaciones resueltas</p>
						<p class="text-xs text-slate-400 mt-2 max-w-[180px]">Sin intervención humana. Tus pacientes obtienen respuestas al instante.</p>
					</div>
					<div class="bg-slate-50 rounded-[2rem] md:rounded-[2.5rem] p-6 md:p-10 text-center flex flex-col items-center justify-center border border-slate-100/80">
						<span class="text-4xl md:text-5xl font-bold text-vitalia-navy mb-2">&lt;90s</span>
						<p class="text-sm md:text-base text-slate-500 font-medium">Tiempo de respuesta</p>
						<p class="text-xs text-slate-400 mt-2 max-w-[180px]">Antes de que tu lead cruce la frontera o busque otra clínica.</p>
					</div>
				</div>

				<!-- Row 3: Chat Demo -->
				<div class="mt-4 md:mt-6">
					<div class="text-center mb-12">
						<h2 class="text-3xl md:text-4xl lg:text-5xl font-medium tracking-tight text-slate-900 mb-4">
							Mira cómo convierte a un <span class="text-vitalia-cyan font-bold">paciente real</span>
						</h2>
						<p class="text-lg text-slate-500 max-w-xl mx-auto">
							Vitalia no da respuestas robotizadas. Cotiza al tipo de cambio del día, empatiza con el viaje largo y asegura la cita con un cobro de fianza.
						</p>
					</div>

					<div class="grid md:grid-cols-2 gap-8 items-center">
						<!-- WhatsApp Chat Mockup -->
						<div class="relative w-full max-w-sm mx-auto">
							<!-- Decorative squares behind -->
							<div class="absolute -top-6 -left-6 w-12 h-12 bg-vitalia-cyan/10 rounded-xl rotate-12"></div>
							<div class="absolute -bottom-4 -right-4 w-8 h-8 bg-vitalia-purple/10 rounded-lg -rotate-6"></div>

							<div class="relative bg-[#efeae2] rounded-3xl p-4 shadow-2xl border border-slate-200/60 h-[420px] overflow-hidden flex flex-col">
								<!-- Chat Header -->
								<div class="bg-white px-4 py-3 rounded-2xl flex items-center gap-3 mb-4 shadow-sm">
									<div class="w-10 h-10 rounded-full bg-gradient-to-br from-vitalia-cyan to-vitalia-navy overflow-hidden flex items-center justify-center">
										<span class="text-white text-sm font-bold">V</span>
									</div>
									<div>
										<p class="font-semibold text-slate-800 text-sm">Vitalia Clínica</p>
										<p class="text-xs text-green-500">En línea</p>
									</div>
								</div>
								<!-- Messages -->
								<div class="flex-1 space-y-3 overflow-hidden">
									<div class="bg-white p-3 rounded-2xl rounded-tl-sm w-[88%] shadow-sm text-sm text-slate-700">
										Hola, viajo mañana desde Iquique. Quería saber si alcanzo a hacerme una evaluación de carillas y si debo pagar algo antes.
									</div>
									<div class="bg-vitalia-cyan/10 p-3 rounded-2xl rounded-tr-sm w-[88%] shadow-sm text-sm text-slate-700 ml-auto">
										¡Hola! Qué buen viaje. Sí alcanzas, pero la agenda del Dr. Pérez para mañana está al 90%. Para bloquear tu espacio y asegurarte atención inmediata apenas cruces Chacalluta, te dejo este link seguro para abonar $20,000 CLP de reserva (que se descuentan del tratamiento).
									</div>
									<div class="bg-white p-3 rounded-2xl rounded-tl-sm w-[75%] shadow-sm text-sm text-slate-700">
										¡Súper! Listo, ya lo pagué. Nos vemos.
									</div>
									<div class="bg-vitalia-cyan/10 p-3 rounded-2xl rounded-tr-sm w-[88%] shadow-sm text-sm text-slate-700 ml-auto">
										Perfecto, tienes cita el sábado 10:30 AM. Te envío la ubicación y tips para cruzar la frontera sin demora 
									</div>
								</div>
								<!-- Input -->
								<div class="mt-3 bg-white rounded-full px-4 py-3 text-slate-400 text-sm shadow-sm flex items-center justify-between">
									Escribe un mensaje...
									<svg class="w-5 h-5 text-vitalia-cyan" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path></svg>
								</div>
							</div>
						</div>

						<!-- Chat features -->
						<div class="space-y-6">
							<div class="flex gap-4 items-start">
								<div class="w-10 h-10 rounded-xl bg-vitalia-cyan/10 flex items-center justify-center flex-shrink-0 mt-1">
									<svg class="w-5 h-5 text-vitalia-cyan" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
								</div>
								<div>
									<h3 class="font-semibold text-slate-900 mb-1">Cotiza en Pesos Chilenos</h3>
									<p class="text-sm text-slate-500">Muestra el ahorro real frente a Chile y elimina la fricción del tipo de cambio.</p>
								</div>
							</div>
							<div class="flex gap-4 items-start">
								<div class="w-10 h-10 rounded-xl bg-vitalia-purple/10 flex items-center justify-center flex-shrink-0 mt-1">
									<svg class="w-5 h-5 text-vitalia-purple" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
								</div>
								<div>
									<h3 class="font-semibold text-slate-900 mb-1">Cobra Fianzas</h3>
									<p class="text-sm text-slate-500">Asegura la asistencia con pagos anticipados y reduce los no-shows a un solo dígito.</p>
								</div>
							</div>
							<div class="flex gap-4 items-start">
								<div class="w-10 h-10 rounded-xl bg-vitalia-yellow/20 flex items-center justify-center flex-shrink-0 mt-1">
									<svg class="w-5 h-5 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
								</div>
								<div>
									<h3 class="font-semibold text-slate-900 mb-1">Logística de Frontera</h3>
									<p class="text-sm text-slate-500">Resuelve dudas sobre Chacalluta, horarios y documentos para que el paciente viaje seguro.</p>
								</div>
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- ==================== INTEGRATIONS SECTION ==================== -->
			<section id="integraciones" class="py-16 md:py-24 px-6 max-w-6xl mx-auto">
				<div class="bg-gradient-to-br from-vitalia-navy to-vitalia-dark rounded-[2.5rem] p-10 md:p-16 relative overflow-hidden">
					<!-- Decorative squares -->
					<div class="absolute top-8 right-12 w-16 h-16 bg-vitalia-cyan/10 rounded-2xl rotate-12"></div>
					<div class="absolute bottom-12 left-16 w-10 h-10 bg-vitalia-purple/15 rounded-xl -rotate-6"></div>
					<div class="absolute top-1/2 right-1/4 w-6 h-6 bg-vitalia-yellow/20 rounded-lg rotate-45"></div>

					<div class="relative z-10 grid md:grid-cols-2 gap-10 items-center">
						<div>
							<h2 class="text-3xl md:text-4xl font-medium tracking-tight text-white mb-4">
								<span class="text-vitalia-cyan font-bold">Integración</span> con todos tus canales
							</h2>
							<p class="text-slate-300 text-lg mb-8 max-w-md">
								Vitalia vive donde están tus pacientes. WhatsApp, Instagram, llamadas telefónicas… siempre lista para interactuar.
							</p>
							<a href="#waitlist" class="inline-flex items-center gap-3 px-7 py-3.5 text-base font-bold text-vitalia-navy bg-white hover:bg-vitalia-cyan transition-all rounded-full group">
						Contrátame ahora
								<svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
							</a>
						</div>

						<!-- Channel icons grid -->
						<div class="grid grid-cols-3 gap-4">
							<div class="bg-white/10 backdrop-blur-sm border border-white/10 rounded-2xl p-6 flex flex-col items-center justify-center aspect-square hover:bg-white/15 transition-colors">
								<div class="w-12 h-12 bg-[#25D366] rounded-xl flex items-center justify-center mb-3 shadow-lg">
									<svg class="w-7 h-7 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
								</div>
								<span class="text-white text-xs font-medium">WhatsApp</span>
							</div>
							<div class="bg-white/10 backdrop-blur-sm border border-white/10 rounded-2xl p-6 flex flex-col items-center justify-center aspect-square hover:bg-white/15 transition-colors">
								<div class="w-12 h-12 bg-gradient-to-tr from-[#f09433] via-[#e6683c] to-[#bc1888] rounded-xl flex items-center justify-center mb-3 shadow-lg">
									<svg class="w-7 h-7 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
								</div>
								<span class="text-white text-xs font-medium">Instagram</span>
							</div>
							<div class="bg-white/10 backdrop-blur-sm border border-white/10 rounded-2xl p-6 flex flex-col items-center justify-center aspect-square hover:bg-white/15 transition-colors">
								<div class="w-12 h-12 bg-vitalia-cyan rounded-xl flex items-center justify-center mb-3 shadow-lg">
									<svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
								</div>
								<span class="text-white text-xs font-medium">AI Calls</span>
							</div>
							<div class="bg-white/10 backdrop-blur-sm border border-white/10 rounded-2xl p-6 flex flex-col items-center justify-center aspect-square hover:bg-white/15 transition-colors">
								<div class="w-12 h-12 bg-white rounded-xl flex items-center justify-center mb-3 shadow-lg p-2">
