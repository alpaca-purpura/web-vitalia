---
import BaseHead from '../components/BaseHead.astro';
import { SEO } from 'astro-seo';

const SITE_TITLE = "Vitalia SaaS | Tu Motor de Crecimiento IA";
const SITE_DESCRIPTION = "Atrae, atiende y retén pacientes 24/7. El ecosistema completo para clínicas en Tacna.";

// JSON-LD schema for AEO/RAG (SoftwareApplication)
const schema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Vitalia",
  "applicationCategory": "BusinessApplication",
  "description": "Vitalia es una plataforma de software como servicio (SaaS) Growth-as-a-Service que integra Inteligencia Artificial para atraer, convertir y fidelizar clientes en clínicas del sector salud y estética en Tacna, resolviendo la logística del turismo médico transfronterizo.",
  "offers": {
    "@type": "Offer",
    "availability": "https://schema.org/PreOrder"
  }
};
---

<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
		<SEO
			title={SITE_TITLE}
			description={SITE_DESCRIPTION}
			openGraph={{
				basic: {
					title: SITE_TITLE,
					type: "website",
					image: "https://vitalialatam.com/og-image.jpg",
				}
			}}
		/>
		<script type="application/ld+json" set:html={JSON.stringify(schema)} />
		<style>
			/* Marquee animation */
			.animate-marquee {
				animation: marquee 30s linear infinite;
			}
			@keyframes marquee {
				0% { transform: translateX(0%); }
				100% { transform: translateX(-50%); }
			}
		</style>
	</head>
	<body class="bg-white text-slate-900 font-sans antialiased overflow-x-hidden selection:bg-vitalia-cyan selection:text-white">
		
		<!-- AEO Identity Block -->
		<div class="sr-only" id="identity-block">
			<h2>¿Qué es Vitalia?</h2>
			<p>Vitalia es una plataforma de software como servicio (SaaS) y agente conversacional de Inteligencia Artificial diseñado para la atracción, conversión y fidelización de clientes en clínicas del sector salud y estética en Tacna.</p>
		</div>

		<!-- Nav -->
		<header class="fixed top-6 w-full z-50 px-6 flex justify-center pointer-events-none">
			<div class="pointer-events-auto bg-white/90 backdrop-blur-md border border-slate-200 shadow-sm rounded-full px-6 py-3 flex items-center justify-between w-full max-w-6xl">
				<div class="flex items-center gap-2">
					<img src="/images/vitalia-logo.png" alt="Vitalia Logo" class="h-8" />
				</div>
				<nav class="hidden md:flex gap-8">
					<a href="#how-it-works" class="text-sm font-semibold text-vitalia-navy hover:text-vitalia-cyan transition-colors">Características</a>
					<a href="#ecosystem" class="text-sm font-semibold text-vitalia-navy hover:text-vitalia-cyan transition-colors">Ecosistema</a>
					<a href="#integrations" class="text-sm font-semibold text-vitalia-navy hover:text-vitalia-cyan transition-colors">Integraciones</a>
				</nav>
				<a href="#waitlist" class="px-6 py-2.5 text-sm font-bold text-white bg-vitalia-cyan hover:bg-vitalia-navy transition-all rounded-full flex items-center gap-2 shadow-[0_4px_12px_rgba(1,178,248,0.3)] group">
					Probar Vitalia
					<svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
				</a>
			</div>
		</header>

		<main class="pt-32 pb-20 space-y-16">
			
			<!-- Top Section: Image & Intro (Bento Box inside max-w) -->
			<div class="px-6 max-w-6xl mx-auto">
				<section class="grid md:grid-cols-2 gap-8">
					<!-- Left: Avatar Image -->
					<div class="bg-vitalia-cyan/10 rounded-[2.5rem] overflow-hidden relative aspect-square md:aspect-auto md:h-full border border-vitalia-cyan/20">
						<!-- Badges -->
						<div class="absolute top-6 left-6 z-10 flex flex-col gap-2">
							<span class="px-4 py-1.5 bg-white/80 backdrop-blur-md text-vitalia-navy text-xs font-bold rounded-full border border-white flex items-center gap-2 shadow-sm">
								<span class="w-2 h-2 rounded-full bg-vitalia-cyan animate-pulse"></span>
								Growth Engine
							</span>
							<span class="px-4 py-1.5 bg-vitalia-navy/80 backdrop-blur-md text-white text-xs font-bold rounded-full border border-vitalia-navy w-fit shadow-sm">
								Atrae, Atiende, Retiene
							</span>
						</div>
						<img src="/images/hero-ai-light.png" alt="Vitalia AI" class="w-full h-full object-cover" />
					</div>

					<!-- Right: Intro text -->
					<div class="bg-vitalia-cyan/5 border border-vitalia-cyan/10 rounded-[2.5rem] p-10 md:p-14 flex flex-col justify-center">
						<h1 class="text-4xl md:text-5xl lg:text-6xl font-medium tracking-tight leading-[1.1] mb-6 text-vitalia-navy">
							Más que un chat. Soy tu <br/>
							<span class="text-vitalia-cyan font-extrabold">Motor de Crecimiento</span>
						</h1>
						<p class="text-lg text-slate-700 mb-10 leading-relaxed max-w-md font-light">
							Olvídate de la recepcionista saturada. Con Vitalia, tu clínica atrae pacientes en automático, los convierte con cotizaciones exactas y les da un seguimiento implacable para que nunca falten a su cita.
						</p>
						<div>
							<a href="#waitlist" class="inline-flex items-center gap-3 px-8 py-4 text-lg font-bold text-white bg-vitalia-cyan hover:bg-vitalia-navy transition-all rounded-full shadow-[0_8px_20px_rgba(1,178,248,0.3)] group">
								Escalar mi clínica
								<div class="w-8 h-8 rounded-full bg-white text-vitalia-cyan flex items-center justify-center group-hover:translate-x-1 transition-transform">
									<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
								</div>
							</a>
						</div>
					</div>
				</section>
			</div>

			<!-- Integrations Strip (Infinite Marquee) -->
			<div class="border-y border-slate-100 bg-slate-50/50 py-8 overflow-hidden relative">
				<div class="absolute inset-y-0 left-0 w-32 bg-gradient-to-r from-white to-transparent z-10"></div>
				<div class="absolute inset-y-0 right-0 w-32 bg-gradient-to-l from-white to-transparent z-10"></div>
				<div class="flex items-center gap-16 w-max animate-marquee text-slate-400 font-medium">
					<!-- Repeated twice for infinite effect -->
					<div class="flex items-center gap-16">
						<span class="flex items-center gap-2"><svg class="w-6 h-6 text-[#25D366]" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg> WhatsApp</span>
						<span class="flex items-center gap-2"><svg class="w-6 h-6 text-[#E1306C]" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg> Instagram</span>
						<span class="flex items-center gap-2"><svg class="w-6 h-6 text-[#0668E1]" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.469h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.469h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg> Meta Ads</span>
						<span class="flex items-center gap-2 text-xl font-bold tracking-tight text-[#000000]"><svg class="w-5 h-5 mr-1" fill="currentColor" viewBox="0 0 24 24"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93v7.2c0 1.95-.53 3.91-1.61 5.48-1.29 1.86-3.23 3.09-5.43 3.23-2.09.12-4.22-.38-5.88-1.64-1.78-1.35-2.9-3.44-3.05-5.69-.17-2.31.78-4.66 2.45-6.15 1.63-1.45 3.86-2.07 5.95-1.78v4.1c-.81-.13-1.66-.02-2.38.38-.8.43-1.42 1.13-1.65 1.99-.21.78-.14 1.63.19 2.37.42.92 1.25 1.64 2.22 1.89.96.25 1.99.14 2.85-.35.9-.53 1.52-1.41 1.69-2.42.06-.39.08-.79.08-1.18V.02z"/></svg>TikTok</span>
						<span class="flex items-center gap-2"><svg class="w-6 h-6" viewBox="0 0 48 48"><path fill="#4285F4" d="M34 6H14c-4.4 0-8 3.6-8 8v20c0 4.4 3.6 8 8 8h20c4.4 0 8-3.6 8-8V14c0-4.4-3.6-8-8-8zm-4 24H18v-2h12v2zm0-4H18v-2h12v2zm0-4H18v-2h12v2z"/></svg> Calendar</span>
						<span class="flex items-center gap-2 text-[#FFE01B] font-bold text-lg">Mailchimp</span>
					</div>
					<!-- Duplicate -->
					<div class="flex items-center gap-16">
						<span class="flex items-center gap-2"><svg class="w-6 h-6 text-[#25D366]" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg> WhatsApp</span>
						<span class="flex items-center gap-2"><svg class="w-6 h-6 text-[#E1306C]" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg> Instagram</span>
						<span class="flex items-center gap-2"><svg class="w-6 h-6 text-[#0668E1]" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.469h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.469h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg> Meta Ads</span>
						<span class="flex items-center gap-2 text-xl font-bold tracking-tight text-[#000000]"><svg class="w-5 h-5 mr-1" fill="currentColor" viewBox="0 0 24 24"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93v7.2c0 1.95-.53 3.91-1.61 5.48-1.29 1.86-3.23 3.09-5.43 3.23-2.09.12-4.22-.38-5.88-1.64-1.78-1.35-2.9-3.44-3.05-5.69-.17-2.31.78-4.66 2.45-6.15 1.63-1.45 3.86-2.07 5.95-1.78v4.1c-.81-.13-1.66-.02-2.38.38-.8.43-1.42 1.13-1.65 1.99-.21.78-.14 1.63.19 2.37.42.92 1.25 1.64 2.22 1.89.96.25 1.99.14 2.85-.35.9-.53 1.52-1.41 1.69-2.42.06-.39.08-.79.08-1.18V.02z"/></svg>TikTok</span>
						<span class="flex items-center gap-2"><svg class="w-6 h-6" viewBox="0 0 48 48"><path fill="#4285F4" d="M34 6H14c-4.4 0-8 3.6-8 8v20c0 4.4 3.6 8 8 8h20c4.4 0 8-3.6 8-8V14c0-4.4-3.6-8-8-8zm-4 24H18v-2h12v2zm0-4H18v-2h12v2zm0-4H18v-2h12v2z"/></svg> Calendar</span>
						<span class="flex items-center gap-2 text-[#FFE01B] font-bold text-lg">Mailchimp</span>
					</div>
				</div>
			</div>

			<!-- How do I work? (Attract, Attend, Retain Focus) -->
			<div class="px-6 max-w-6xl mx-auto py-12" id="how-it-works">
				<div class="mb-10 text-center">
					<div class="inline-block px-4 py-1.5 bg-vitalia-cyan text-white text-xs font-bold rounded-full mb-4">La Metodología Vitalia</div>
					<h2 class="text-3xl md:text-4xl font-medium text-vitalia-navy">Mucho más que "responder mensajes"</h2>
					<p class="text-slate-600 mt-4 max-w-2xl mx-auto">Vitalia no es un chatbot estático. Es un sistema proactivo que maneja todo el viaje del paciente transfronterizo, desde que ve tu anuncio hasta que regresa a casa.</p>
				</div>

				<div class="grid md:grid-cols-3 gap-6">
					<!-- Card 1: Atraer -->
					<div class="bg-[#f8f9fa] border border-slate-200 rounded-2xl p-8 hover:shadow-lg transition-shadow">
						<div class="w-12 h-12 rounded-xl bg-vitalia-cyan/10 flex items-center justify-center text-vitalia-cyan mb-6">
							<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5M7.188 2.239l.777 2.897M5.136 7.965l-2.898-.777M13.95 4.05l-2.122 2.122m-5.657 5.656l-2.12 2.122"></path></svg>
						</div>
						<h3 class="text-xl font-bold text-vitalia-navy mb-3">1. Atraer (Adquisición)</h3>
						<p class="text-slate-600 text-sm">Creamos Landing Pages optimizadas para tus tratamientos top. Conectamos tus campañas de Meta Ads directamente al cerebro de Vitalia para captar prospectos calificados desde Chile al instante.</p>
					</div>
					<!-- Card 2: Atender -->
					<div class="bg-[#f8f9fa] border border-slate-200 rounded-2xl p-8 hover:shadow-lg transition-shadow">
						<div class="w-12 h-12 rounded-xl bg-vitalia-purple/10 flex items-center justify-center text-vitalia-purple mb-6">
							<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path></svg>
						</div>
						<h3 class="text-xl font-bold text-vitalia-navy mb-3">2. Atender (Conversión)</h3>
						<p class="text-slate-600 text-sm">Respuesta en < 90 segundos 24/7. Vitalia cotiza en Pesos Chilenos (CLP), explica la logística de cruzar la frontera (Chacalluta), califica al paciente y agenda en tu Google Calendar.</p>
					</div>
					<!-- Card 3: Retener -->
					<div class="bg-[#f8f9fa] border border-slate-200 rounded-2xl p-8 hover:shadow-lg transition-shadow">
						<div class="w-12 h-12 rounded-xl bg-vitalia-yellow/20 flex items-center justify-center text-yellow-600 mb-6">
